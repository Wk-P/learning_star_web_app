{
  // 跨平台统一：UTF-8 + LF；PowerShell 脚本 UTF-8 BOM + CRLF（见 .editorconfig、.gitattributes）
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "[powershell]": {
    "files.encoding": "utf8bom",
    "files.eol": "\r\n"
  },
  // 集成终端里的 Python 以 UTF-8 模式运行（Windows 默认按 GBK 读写文件）
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1"
  }
}
