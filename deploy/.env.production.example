# 线上后端的 .env（模板）。复制为 deploy/.env.production 后填写；该文件不进 git。
# 由 uv run scripts/deploy.py env（以及 all、cutover）上传到服务器的 ENV_REMOTE（默认 ~/learning_star/.env，权限 600）。
# 已有线上环境时，可先 uv run scripts/deploy.py env-pull 把服务器当前的 .env 拉下来作为起点。

DEBUG=False
# 至少 32 字符；生成：python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# 登录令牌签名密钥；改动后所有用户需要重新登录。留空则使用 SECRET_KEY
JWT_SIGNING_KEY=
# 服务器的域名或 IP，逗号分隔
ALLOWED_HOSTS=
# 前后端同域部署时留空
CORS_ALLOWED_ORIGINS=
