# 部署脚本 deploy.sh 的服务器信息。复制为 deploy/.env 后填写；deploy/.env 不进 git、不会上传到服务器
# 也可以用同名环境变量临时覆盖，例如：SSH_HOST=user@1.2.3.4 ./scripts/unix/deploy.sh web

# SSH 登录：用户@主机、端口、私钥路径
SSH_HOST=user@your.server.ip
SSH_PORT=22
SSH_KEY=~/.ssh/your_deploy_key.pem

# 服务器上的部署根目录
REMOTE_HOME=/home/user

# 各项目目录（可省略，默认为 REMOTE_HOME 下的 player3 / course_system / learning_star）
# TOPIK_DIR=/home/user/player3
# COURSE_DIR=/home/user/course_system
# WEB_DIR=/home/user/learning_star
