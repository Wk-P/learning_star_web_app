[Unit]
Description=Learning Star backend (Django / gunicorn)
After=network.target

[Service]
User={{USER}}
WorkingDirectory={{APP_DIR}}/backend
# 配置文件位置（deploy/.env 的 ENV_REMOTE），由 scripts/deploy.py env 从本地送上来，不进 git
Environment=ENV_FILE={{ENV_FILE}}
ExecStart={{APP_DIR}}/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:{{PORT}} \
    --workers 3 \
    --timeout 300 \
    --access-logfile {{APP_DIR}}/log/gunicorn_access.log \
    --error-logfile {{APP_DIR}}/log/gunicorn_error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
