# 后端环境变量（backend/config/settings.py 读取仓库根目录的 .env）
# 本地开发：uv run scripts/dev.py setup 会由本文件生成 .env 并打开 DEBUG
# 服务器：放在部署目录（如 ~/learning_star/.env），systemd 与 manage.py 都读取它
# 任何 .env 都不要提交到 git

DEBUG=False
# 生产必须设置；生成：python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# 登录令牌签名密钥；切换到统一后端时沿用旧 topik 的 JWT_SIGNING_KEY，已登录用户不会掉线
JWT_SIGNING_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# 前后端同域部署时留空即可
CORS_ALLOWED_ORIGINS=

# 数据目录（数据库 db.sqlite3 与 media/），默认为本文件所在目录下的 data/
# DATA_DIR=/path/to/data

# 本地测试管理员（scripts/dev.py setup 用；生产不需要）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
